<Window x:Class="AefAccount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:AefAccount.Localization"
        Title="{loc:Loc window_title}"
        Width="1480" Height="920"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="Assets/akef.ico"
        Background="{DynamicResource Brush.Bg.Canvas}"
        Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Panel}"
                BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="10" Height="10" Fill="{DynamicResource Brush.Accent}"/>
                    <TextBlock Text="AK:EF" FontFamily="{StaticResource Font.Display}" FontSize="12"
                               FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="// LEDGER" Style="{StaticResource Text.Kicker}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Width="30" Height="28"
                            Click="Minimize_Click" ToolTip="{loc:Loc window_minimize}">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="28"
                            Click="Maximize_Click" ToolTip="{loc:Loc window_maximize}">
                        <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="28"
                            Click="Close_Click" ToolTip="{loc:Loc window_close}">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Panel}"
                    BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="18" Fill="{DynamicResource Brush.Accent}" Margin="0,0,8,0"/>
                                <TextBlock Text="AK:EF" FontFamily="{StaticResource Font.Display}" FontSize="18"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="// LEDGER" Style="{StaticResource Text.Kicker}" Margin="12,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="{loc:Loc sidebar_data}" Style="{StaticResource Text.Kicker}"
                                   Margin="16,0,0,8"/>
                        <ListBox x:Name="NavList"
                                 Style="{StaticResource NavList}"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedIndex="0"
                                 SelectionChanged="NavList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0"
                                                   FontFamily="{StaticResource Font.Ui}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{loc:Loc sidebar_system}" Style="{StaticResource Text.Kicker}"
                                   Margin="16,24,0,8"/>
                        <StackPanel Margin="16,0,16,0">
                            <Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                                    Click="OpenSite_Click" Padding="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc sidebar_site}" FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,0,16,16">
                        <Border Background="{DynamicResource Brush.Bg.Raised}"
                                BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="1"
                                Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Text.Faint}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FreshnessState}" Value="Good">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Good}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FreshnessState}" Value="Warn">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warn.Fill}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FreshnessState}" Value="Bad">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Bad.Fill}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding FreshnessText}" Style="{StaticResource Text.MonoSmall}"
                                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.MonoSmall}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Brush.Text.Faint}">
                                    <Run Text="{loc:Loc sidebar_snapshot}"/><Run Text=" "/><Run Text="{Binding Meta.Latest.Id, Mode=OneWay}"/>
                                    <Run Text=" · v"/><Run Text="{Binding Meta.Latest.GameVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:Loc sidebar_footer}" Style="{StaticResource Text.MonoSmall}"
                                   FontSize="9" Foreground="{DynamicResource Brush.Text.Faint}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main column -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Topbar -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Panel}"
                        BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="0,0,0,1"
                        Padding="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageEyebrow}" Style="{StaticResource Text.Kicker}"/>
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.H1}" Margin="0,-2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="2" BorderThickness="1" Height="22" Padding="8,0" Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FreshnessState}" Value="Good">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Good}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FreshnessState}" Value="Warn">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn.Fill}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FreshnessState}" Value="Bad">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bad.Fill}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FreshnessText}" Style="{StaticResource Text.MonoSmall}"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <ComboBox Width="172" Margin="0,0,8,0"
                                      ItemsSource="{Binding Snapshots}"
                                      SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabelShort}" FontSize="11"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                                    ToolTip="{loc:Loc topbar_refresh_tooltip}" Margin="0,0,8,0">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>

                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding TakeSnapshotCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc topbar_take_snapshot}" Foreground="{DynamicResource Brush.Text.OnAccent}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status -->
                <Border Grid.Row="1" Margin="24,12,24,0" Padding="12,8"
                        Background="{DynamicResource Brush.Bg.Raised}"
                        BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="1"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Good}"/>
                            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bad.Fill}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="3" VerticalAlignment="Stretch">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Good}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Bad.Fill}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,10,0"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24"
                                Command="{Binding ClearStatusCommand}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="2" Margin="24,16,24,0">
                    <Grid x:Name="ContentHost"/>
                    <Border Background="#CC000000"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{DynamicResource Brush.Bg.Panel}"
                                BorderBrush="{DynamicResource Brush.Line.Strong}" BorderThickness="1"
                                Width="320" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc busy_reading}" Style="{StaticResource Text.Kicker}"/>
                                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Body}" Margin="0,6,0,12"/>
                                <Grid Height="2" ClipToBounds="True">
                                    <Rectangle Width="90" Height="2" Fill="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Left">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="LoadBar"/>
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="LoadBar"
                                                                         Storyboard.TargetProperty="X"
                                                                         From="-90" To="320" Duration="0:0:1.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="24,8,24,8">
                    <TextBlock Text="AK:EF LEDGER · SKPORT API · SQLITE"
                               Style="{StaticResource Text.MonoSmall}" FontSize="9"
                               Foreground="{DynamicResource Brush.Text.Faint}"/>
                    <TextBlock Style="{StaticResource Text.MonoSmall}" FontSize="9"
                               Foreground="{DynamicResource Brush.Text.Faint}" HorizontalAlignment="Right">
                        <Run Text="UTC+8 · "/><Run Text="{Binding Meta.CurrentVersion, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>



