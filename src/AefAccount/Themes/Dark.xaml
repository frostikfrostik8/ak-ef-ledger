<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Bg.Canvas" Color="#121212" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Bg.Panel" Color="#191919" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Bg.Raised" Color="#262626" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Bg.Hover" Color="#2E2E2E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Bg.Selected" Color="#383838" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Bg.Sunken" Color="#0E0E0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Line.Soft" Color="#2A2A2A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Line" Color="#3A3A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Line.Strong" Color="#4A4A4A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#99000000" po:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#F2F2F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B1B1B1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#8A8A8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Faint" Color="#6A6A6A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#141414" po:Freeze="True"/>

    <!-- Accent and status -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFFA00" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#F0EC00" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Wash" Color="#24FFFA00" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent2" Color="#5B84FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Good" Color="#B0D040" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="#FF8A3D" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warn.Fill" Color="#F87000" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Bad" Color="#FF6255" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Bad.Fill" Color="#E5342A" po:Freeze="True"/>

    <!-- Elements -->
    <SolidColorBrush x:Key="Brush.Element.Physical" Color="#444444" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Heat" Color="#FF633D" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Electric" Color="#FFC001" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Cryo" Color="#22C6D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Nature" Color="#C3E354" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Physical.Tint" Color="#1C1C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Heat.Tint" Color="#2A1C17" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Electric.Tint" Color="#2A2413" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Cryo.Tint" Color="#15292B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Element.Nature.Tint" Color="#222A1A" po:Freeze="True"/>

    <!-- Rarity -->
    <SolidColorBrush x:Key="Brush.Rarity.4" Color="#8A8A8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Rarity.5" Color="#B9C7D9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Rarity.6" Color="#F7D481" po:Freeze="True"/>

    <!-- Paper / document layer -->
    <SolidColorBrush x:Key="Brush.Paper" Color="#FAF8F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Paper.Edge" Color="#D9D9D9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Paper.Ink" Color="#1A1A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Paper.Muted" Color="#6E6E6E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Paper.Faint" Color="#8F8F8F" po:Freeze="True"/>

    <!-- Textures -->
    <DrawingBrush x:Key="Tex.Hatch" TileMode="Tile"
                  Viewport="0,0,6.2,6.2" ViewportUnits="Absolute"
                  Viewbox="0,0,6.2,6.2" ViewboxUnits="Absolute" Opacity="0.06">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,6.2 L6.2,0">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Tex.Hatch.Paper" TileMode="Tile"
                  Viewport="0,0,6.2,6.2" ViewportUnits="Absolute"
                  Viewbox="0,0,6.2,6.2" ViewboxUnits="Absolute" Opacity="0.05">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,6.2 L6.2,0">
                <GeometryDrawing.Pen>
                    <Pen Brush="#000000" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Tex.Dots" TileMode="Tile"
                  Viewport="0,0,12,12" ViewportUnits="Absolute"
                  Viewbox="0,0,12,12" ViewboxUnits="Absolute" Opacity="0.05">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFF">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="2,2" RadiusX="1.8" RadiusY="1.8"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
