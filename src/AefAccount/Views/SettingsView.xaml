<UserControl x:Class="AefAccount.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AefAccount.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145*"/>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc settings_interface}" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18">
                        <StackPanel>
                            <Grid MinHeight="54">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Loc settings_language}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc settings_language_hint}" Style="{StaticResource Text.Meta}"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="170"
                                              ItemsSource="{Binding LanguageOptions}"
                                              SelectedItem="{Binding SelectedLanguage}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}" FontSize="12"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="4,0,0,0"
                                            Command="{Binding ReloadLanguagesCommand}"
                                            ToolTip="{loc:Loc settings_reload_languages_tooltip}">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,4,0,8"/>

                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings_test_operators}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc settings_test_operators_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowTestOperators, Mode=TwoWay}"/>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,4,0,8"/>

                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings_dev_profile}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc settings_dev_profile_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding UseDevProfile, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc settings_art}" Style="{StaticResource Text.Kicker}" Margin="0,24,0,8"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Loc settings_art_title}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{Binding ArtStatusText}" Style="{StaticResource Text.Meta}"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                        Click="DownloadArt_Click" IsEnabled="{Binding CanUseArt}">
                                    <TextBlock Text="{loc:Loc settings_art_download}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding ArtPathText}" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <ProgressBar Style="{StaticResource AefProgress}" Height="3" Margin="0,8,0,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ArtProgress, Mode=OneWay}"
                                         Visibility="{Binding IsArtBusy, Converter={StaticResource BoolToVisibility}}"/>

                            <Border Style="{StaticResource Divider}" Margin="0,10,0,10"/>

                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Height="28" Margin="0,0,6,6"
                                        Click="PickArtFolder_Click" IsEnabled="{Binding CanUseArt}">
                                    <TextBlock Text="{loc:Loc settings_art_folder}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="28" Margin="0,0,6,6"
                                        Click="InstallArtZip_Click" IsEnabled="{Binding CanUseArt}">
                                    <TextBlock Text="{loc:Loc settings_art_zip}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Height="28" Margin="0,0,6,6"
                                        Click="OpenArtFolder_Click">
                                    <TextBlock Text="{loc:Loc settings_art_open}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Height="28" Margin="0,0,0,6"
                                        Click="RemoveArt_Click" IsEnabled="{Binding CanRemoveArtNow}">
                                    <TextBlock Text="{loc:Loc settings_art_remove}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc settings_test_data}" Style="{StaticResource Text.Kicker}" Margin="0,24,0,8"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18">
                        <StackPanel>
                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings_stub_operator}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc settings_stub_operator_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding AddTestOperatorCommand}">
                                    <TextBlock Text="{loc:Loc action_add}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,2,0,4"/>

                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings_vesper}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc settings_vesper_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding AddVesperCommand}">
                                    <TextBlock Text="{loc:Loc action_add}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,2,0,4"/>

                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings_dev_profile_short}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc settings_dev_profile_short_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding LoadDevProfileCommand}">
                                    <TextBlock Text="{loc:Loc action_load}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,2,0,4"/>

                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings_reset_test}" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc settings_reset_test_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding ResetTestDataCommand}">
                                    <TextBlock Text="{loc:Loc action_reset}" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="3" Height="18" Fill="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource Text.Meta}"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Loc settings_about}" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="22" Fill="{DynamicResource Brush.Accent}" Margin="0,0,8,0"/>
                                <TextBlock Text="AK:EF Ledger" Style="{StaticResource Text.H1}" FontSize="24"/>
                            </StackPanel>
                            <TextBlock Text="Arknights: Endfield · account terminal" Style="{StaticResource Text.Meta}"
                                       FontSize="11" Margin="12,4,0,0"/>
                            <TextBlock Text="v0.4.2" Style="{StaticResource Text.MonoSmall}" Margin="12,8,0,0"/>

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                            <TextBlock Text="{loc:Loc settings_data}" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                            <TextBlock Text="{Binding DbPath}" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{loc:Loc settings_scripts}" Style="{StaticResource Text.Kicker}" FontSize="9" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding RepoRoot, StringFormat={}{0}\scripts\snapshot.py}" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{loc:Loc settings_secrets}" Style="{StaticResource Text.Kicker}" FontSize="9" Margin="0,10,0,0"/>
                            <TextBlock Text="{loc:Loc settings_secrets_hint}" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Click="OpenSite_Click" Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc settings_open_site}" FontSize="10" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Click="OpenRepository_Click" Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc settings_repository}" FontSize="10" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Click="OpenLangFolder_Click">
                                <TextBlock Text="{loc:Loc settings_open_lang_folder}" FontSize="10" FontWeight="SemiBold"/>
                            </Button>
                            <TextBlock Text="endfield.gryphline.com" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" Foreground="{DynamicResource Brush.Text.Faint}" Margin="0,6,0,0"/>

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                            <TextBlock Text="{loc:Loc settings_creator}" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                            <TextBlock Text="frostikfrostik8" Style="{StaticResource Text.H3}"
                                       FontSize="13" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                        Click="OpenGitHubProfile_Click" Margin="0,0,4,0">
                                    <TextBlock Text="GitHub" FontSize="9" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                        Click="CopyDiscord_Click">
                                    <TextBlock Text="Discord · frostikfrostik8" FontSize="9" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc settings_discord_hint}" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings_dev_tip}" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                            <TextBlock Text="{loc:Loc settings_dev_tip_1}"
                                       Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{loc:Loc settings_dev_tip_2}"
                                       Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
