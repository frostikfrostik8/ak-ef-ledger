<UserControl x:Class="AefAccount.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145*"/>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="// ИНТЕРФЕЙС" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18">
                        <StackPanel>
                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Язык интерфейса" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="EN появится после парсинга терминов с вики" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <ComboBox Width="130" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage}"/>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,4,0,8"/>

                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Показывать тестовых операторов" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="Заглушки и Веспер в ростере и «Костяке»" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowTestOperators, Mode=TwoWay}"/>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,4,0,8"/>

                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DEV-профиль снимков" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="8 фейковых снимков для проверки графика и diff" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding UseDevProfile, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="// ТЕСТОВЫЕ ДАННЫЕ" Style="{StaticResource Text.Kicker}" Margin="0,24,0,8"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18">
                        <StackPanel>
                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Персонаж-заглушка" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="Случайные статы, без арта — на карточке будет буква" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding AddTestOperatorCommand}">
                                    <TextBlock Text="ДОБАВИТЬ" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,2,0,4"/>

                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Веспер · тестовые арты" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="Прозрачные icon / portrait / full, 6★ Cryo Striker" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding AddVesperCommand}">
                                    <TextBlock Text="ДОБАВИТЬ" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,2,0,4"/>

                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DEV-профиль" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="8 снимков: уровень, рассудок, BP, кредиты, Seek" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding LoadDevProfileCommand}">
                                    <TextBlock Text="ЗАГРУЗИТЬ" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,2,0,4"/>

                            <Grid Height="52">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Сбросить тестовые данные" Style="{StaticResource Text.H3}" FontSize="13"/>
                                    <TextBlock Text="Убрать заглушки и вернуть реальные снимки" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Command="{Binding ResetTestDataCommand}">
                                    <TextBlock Text="СБРОСИТЬ" FontSize="10" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="3" Height="18" Fill="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource Text.Meta}"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="// О ПРИЛОЖЕНИИ" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="22" Fill="{DynamicResource Brush.Accent}" Margin="0,0,8,0"/>
                                <TextBlock Text="AK:EF Ledger" Style="{StaticResource Text.H1}" FontSize="24"/>
                            </StackPanel>
                            <TextBlock Text="Arknights: Endfield · account terminal" Style="{StaticResource Text.Meta}"
                                       FontSize="11" Margin="12,4,0,0"/>
                            <TextBlock Text="v0.3.0" Style="{StaticResource Text.MonoSmall}" Margin="12,8,0,0"/>

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                            <TextBlock Text="ДАННЫЕ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                            <TextBlock Text="{Binding DbPath}" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="СКРИПТЫ" Style="{StaticResource Text.Kicker}" FontSize="9" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding RepoRoot, StringFormat={}{0}\scripts\snapshot.py}" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="СЕКРЕТЫ" Style="{StaticResource Text.Kicker}" FontSize="9" Margin="0,10,0,0"/>
                            <TextBlock Text=".secrets\endfield_token — только локально" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Click="OpenSite_Click">
                                <TextBlock Text="ОТКРЫТЬ ОФИЦИАЛЬНЫЙ САЙТ" FontSize="10" FontWeight="SemiBold"/>
                            </Button>
                            <TextBlock Text="endfield.gryphline.com" Style="{StaticResource Text.MonoSmall}"
                                       FontSize="9" Foreground="{DynamicResource Brush.Text.Faint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="// DEV-ПОДСКАЗКА" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                            <TextBlock Text="DEV-профиль не пишет в SQLite: снимки живут в памяти до перезапуска или «Сбросить»."
                                       Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="После загрузки приложение само перейдёт в «Динамику»."
                                       Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>


