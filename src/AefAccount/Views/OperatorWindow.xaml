<Window x:Class="AefAccount.Views.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AefAccount.Controls"
        Title="Оператор"
        Width="1000" Height="880"
        MinWidth="840" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Brush.Bg.Canvas}"
        Foreground="{DynamicResource Brush.Paper.Ink}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PaperPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Paper.Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PaperChip" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Paper.Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="22"/>
        </Style>

        <Style x:Key="PaperLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Paper.Muted}"/>
        </Style>

        <Style x:Key="PaperMono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Paper.Muted}"/>
        </Style>

        <Style x:Key="PaperProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Paper.Edge}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Panel}"
                BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="10" Height="10" Fill="{DynamicResource Brush.Accent}"/>
                    <Border Width="20" Height="20" Margin="8,0,0,0" Background="{DynamicResource Brush.Bg.Raised}"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Display}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Name, Converter={StaticResource OperatorArtVisibility}, ConverterParameter=icon}"/>
                            <Image Source="{Binding Name, Converter={StaticResource OperatorArt}, ConverterParameter=icon}"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="// ОПЕРАТОР" Style="{StaticResource Text.Kicker}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EnglishName}" Style="{StaticResource Text.Kicker}"
                               Foreground="{DynamicResource Brush.Text.Faint}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="30" Height="28"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16" Background="{DynamicResource Brush.Paper}"
                BorderBrush="{DynamicResource Brush.Paper.Edge}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.Row="0" Fill="{DynamicResource Brush.Accent}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">

                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="// ОПЕРАТОР" Style="{StaticResource PaperMono}" FontSize="9"/>
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.PaperName}" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding EnglishName}" Style="{StaticResource PaperMono}"/>
                                    <TextBlock Text="  ·  " Style="{StaticResource PaperMono}"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PaperMono}"/>
                                </StackPanel>
                                <controls:RarityChevrons Rarity="{Binding Rarity}" Margin="0,10,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource Brush.Accent}" Width="118" Height="78"
                                    VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Level}" FontFamily="{StaticResource Font.Display}"
                                               FontSize="38" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                                               HorizontalAlignment="Center" LineHeight="40"/>
                                    <TextBlock Text="LEVEL" FontFamily="{StaticResource Font.Mono}" FontSize="9"
                                               FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnAccent}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource Brush.Paper.Edge}" Height="1" Margin="0,20,0,20"/>

                        <!-- Hero + stats -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Media: double frame -->
                            <Border Grid.Column="0" Background="{Binding ElementTintHex, Converter={StaticResource HexBrush}}"
                                    BorderBrush="{DynamicResource Brush.Paper.Ink}" BorderThickness="1" Padding="3">
                                <Border BorderBrush="#FFFFFFFF" BorderThickness="1" ClipToBounds="True">
                                    <Grid Height="430">
                                        <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Display}"
                                                   FontSize="64" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Paper.Faint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Name, Converter={StaticResource OperatorArtVisibility}, ConverterParameter=full}"/>
                                        <Image Source="{Binding Name, Converter={StaticResource OperatorArt}, ConverterParameter=full}"
                                               Stretch="Uniform" Margin="12"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Width="26" Height="26" Background="#B3000000"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding ClassCode}" FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="7" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="26" Height="26" Background="{Binding ElementHex, Converter={StaticResource HexBrush}}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding ElementCode}" FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="6.5" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Rectangle Height="3" VerticalAlignment="Bottom"
                                                   Fill="{Binding ElementHex, Converter={StaticResource HexBrush}}"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Stats -->
                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <TextBlock Text="// ПОКАЗАТЕЛИ" Style="{StaticResource PaperMono}" FontSize="9"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Редкость" Style="{StaticResource PaperLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Rarity, StringFormat={}{0}★}"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Paper.Ink}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="Стихия" Style="{StaticResource PaperLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Element}" Style="{StaticResource PaperMono}"
                                               FontSize="12" Foreground="{DynamicResource Brush.Paper.Ink}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="Класс" Style="{StaticResource PaperLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Class}" Style="{StaticResource PaperMono}"
                                               FontSize="12" Foreground="{DynamicResource Brush.Paper.Ink}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="Потенциал" Style="{StaticResource PaperLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PotentialText}" Style="{StaticResource PaperMono}"
                                               FontSize="12" Foreground="{DynamicResource Brush.Paper.Ink}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Text="Прорыв" Style="{StaticResource PaperLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EvolveText}" Style="{StaticResource PaperMono}"
                                               FontSize="12" Foreground="{DynamicResource Brush.Paper.Ink}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="5" Text="Получен" Style="{StaticResource PaperLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AcquiredText}" Style="{StaticResource PaperMono}"
                                               FontSize="11" Foreground="{DynamicResource Brush.Paper.Ink}" VerticalAlignment="Center"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,12,0,0"
                                              Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PaperChip}" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.Paper.Muted}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource PaperPanel}" Padding="14" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="// ОРУЖИЕ" Style="{StaticResource PaperMono}" FontSize="9"/>
                                            <TextBlock Text="{Binding WeaponName, TargetNullValue=Не надето}"
                                                       FontFamily="{StaticResource Font.Ui}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Paper.Ink}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding WeaponSummary}" Style="{StaticResource PaperMono}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding WeaponGem, StringFormat=Сфера: {0}}" Style="{StaticResource PaperMono}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding WeaponRefineText}" Style="{StaticResource PaperMono}"
                                                   FontSize="18" Foreground="{DynamicResource Brush.Paper.Ink}"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding WeaponSkills}" Margin="0,8,0,0"
                                              Visibility="{Binding HasWeaponSkills, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Style="{StaticResource PaperMono}" Margin="0,1,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- Gear -->
                        <TextBlock Text="// ГИР" Style="{StaticResource PaperMono}" FontSize="9" Margin="0,24,0,8"/>
                        <ItemsControl ItemsSource="{Binding GearSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PaperPanel}" Padding="11" Margin="0,0,8,0" MinHeight="104">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource PaperMono}" FontSize="9"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Ui}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Paper.Ink}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource PaperMono}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Suit}" Style="{StaticResource PaperMono}" FontSize="9"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Brush.Paper.Faint}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Skills -->
                        <TextBlock Text="// СКИЛЛЫ" Style="{StaticResource PaperMono}" FontSize="9" Margin="0,24,0,8"/>
                        <Border Style="{StaticResource PaperPanel}" Padding="14">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Skills}"
                                              Visibility="{Binding HasSkills, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="62"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Ui}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Paper.Ink}"/>
                                                    <TextBlock Text="{Binding Type}" Style="{StaticResource PaperMono}" FontSize="9"/>
                                                </StackPanel>
                                                <ProgressBar Grid.Column="1" Style="{StaticResource PaperProgress}"
                                                             Value="{Binding Percent, Mode=OneWay}"
                                                             VerticalAlignment="Center" Margin="12,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LevelText}" HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Paper.Ink}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Скиллы не пришли в ответе." Style="{StaticResource PaperMono}"
                                           Visibility="{Binding HasSkills, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Talents -->
                        <TextBlock Text="// ТАЛАНТЫ" Style="{StaticResource PaperMono}" FontSize="9" Margin="0,24,0,8"/>
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <Border Style="{StaticResource PaperPanel}" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ПРОРЫВ" Style="{StaticResource PaperMono}" FontSize="9"/>
                                    <TextBlock Text="{Binding Talents.BreakLabel}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="14" Foreground="{DynamicResource Brush.Paper.Ink}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PaperPanel}" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ПАССИВНЫЕ" Style="{StaticResource PaperMono}" FontSize="9"/>
                                    <TextBlock Text="{Binding Talents.PassiveText}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="14" Foreground="{DynamicResource Brush.Paper.Ink}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PaperPanel}" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ФАБРИКА" Style="{StaticResource PaperMono}" FontSize="9"/>
                                    <TextBlock Text="{Binding Talents.FactoryText}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="14" Foreground="{DynamicResource Brush.Paper.Ink}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PaperPanel}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="КОРАБЛЬ" Style="{StaticResource PaperMono}" FontSize="9"/>
                                    <TextBlock Text="{Binding Talents.ShipText}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="14" Foreground="{DynamicResource Brush.Paper.Ink}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
