<UserControl x:Class="AefAccount.Views.SnapshotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ВСЕГО СНИМКОВ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding Meta.SnapshotsCount}" Style="{StaticResource Text.Value}" FontSize="24" Margin="0,2,0,0"/>
                    <TextBlock Text="в архиве" Style="{StaticResource Text.Meta}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ПОСЛЕДНИЙ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding Meta.Latest.DisplayDateShort}" Style="{StaticResource Text.H2}" FontSize="16" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Meta.Latest.GameVersion, StringFormat=v{0}}" Style="{StaticResource Text.MonoSmall}" FontSize="9"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ПЕРВЫЙ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding FirstSnapshot.DisplayDateShort}" Style="{StaticResource Text.H2}" FontSize="16" Margin="0,5,0,0"/>
                    <TextBlock Text="начало архива" Style="{StaticResource Text.Meta}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="ТЕКУЩАЯ ВЕРСИЯ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding Meta.CurrentVersion}" Style="{StaticResource Text.Value}" FontSize="24" Margin="0,2,0,0"/>
                    <TextBlock Text="по календарю" Style="{StaticResource Text.Meta}" FontSize="11"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Bg.Panel}"
                BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Panel}"
                        BorderBrush="{DynamicResource Brush.Line.Strong}" BorderThickness="0,0,0,2"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="ДАТА UTC+8" Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="ВЕРСИЯ" Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="УР." Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="WORLD" Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="ОП." Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="ОРУЖ." Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="РАССУДОК" Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="BP" Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Text="ДОСТИЖ." Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Text="ИЗМЕНЕНИЯ" Style="{StaticResource Text.Kicker}" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Snapshots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Bg.Panel}"
                                        BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="0,0,0,1"
                                        Padding="12,0" Height="34">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id, StringFormat=#{0}}" Style="{StaticResource Text.MonoSmall}"
                                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayDate}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource ChipBorder}" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Padding="6,1" Height="20">
                                            <TextBlock Text="{Binding GameVersion}" Style="{StaticResource Text.MonoSmall}"
                                                       FontSize="9" Foreground="{DynamicResource Brush.Text}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding PlayerLevel}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding WorldLevel}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding CharNum}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding WeaponNum}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding StaminaText}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="{Binding BpText}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="{Binding AchieveCount}" Style="{StaticResource Text.MonoSmall}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="10" Text="{Binding DiffSummary}" Style="{StaticResource Text.Meta}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="11" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource QuietButton}" Height="24" Padding="8,0"
                                                    Click="OpenSnapshot_Click">
                                                <TextBlock Text="ОТКРЫТЬ" FontSize="9" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Style="{StaticResource QuietButton}" Height="24" Padding="8,0" Margin="2,0,0,0"
                                                    Click="OpenReport_Click">
                                                <TextBlock Text="ОТЧЁТ" FontSize="9" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Style="{StaticResource QuietButton}" Height="24" Padding="8,0" Margin="2,0,0,0"
                                                    Click="OpenRaw_Click">
                                                <TextBlock Text="JSON" FontSize="9" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

