<UserControl x:Class="AefAccount.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AefAccount.Controls"
             xmlns:loc="clr-namespace:AefAccount.Localization">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Kicker}">
            <Setter Property="FontSize" Value="9"/>
        </Style>
        <Style x:Key="SmallValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <!-- Hero -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="24" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="// ENDMINISTRATOR" Style="{StaticResource Text.Kicker}"/>
                                <TextBlock Text="{Binding Data.Snapshot.PlayerName}" Style="{StaticResource Text.H1}"
                                           FontSize="30" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Margin="0,6,0,0">
                                    <Run Text="UID "/><Run Text="{Binding Data.Snapshot.RoleId, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="  ·  "/><Run Text="{Binding Data.Snapshot.ServerName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Border Style="{StaticResource ChipBorder}">
                                    <TextBlock Style="{StaticResource Text.MonoSmall}" FontSize="10">
                                        <Run Text="PATCH "/><Run Text="{Binding Data.Snapshot.GameVersion, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Data.Snapshot.DisplayDate}" Style="{StaticResource Text.MonoSmall}"
                                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc overview_level}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.PlayerLevel}" Style="{StaticResource Text.Value}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="WORLD LEVEL" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.WorldLevel}" Style="{StaticResource Text.Value}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc overview_exp}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.ExpText}" Style="{StaticResource SmallValue}"
                                           Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc overview_created}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.CreatedText}" Style="{StaticResource Text.Meta}"
                                           FontSize="12" Margin="0,9,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Line.Soft}"
                                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,20,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MISSION" Style="{StaticResource StatLabel}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Data.Snapshot.MainMission}" Style="{StaticResource Text.Body}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.MonoSmall}" HorizontalAlignment="Right">
                                    <Run Text="{loc:Loc overview_last_login}"/><Run Text=": "/><Run Text="{Binding Data.Snapshot.LastLoginText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{loc:Loc overview_snapshot}" Style="{StaticResource Text.Kicker}"/>
                            <TextBlock Style="{StaticResource Text.MonoSmall}" HorizontalAlignment="Right">
                                <Run Text="#"/><Run Text="{Binding Data.Snapshot.Id, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding FreshnessText}" Margin="0,14,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FreshnessState}" Value="Good">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Good}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FreshnessState}" Value="Warn">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FreshnessState}" Value="Bad">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Meta.SnapshotsCount, Converter={StaticResource LocFormat}, ConverterParameter=overview_archive_count}"
                                   Style="{StaticResource Text.Meta}" FontSize="11"/>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc overview_taken_at}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="{Binding Data.Snapshot.DisplayDate}" HorizontalAlignment="Right"
                                       Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc overview_version}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="{Binding Data.Snapshot.GameVersion}" HorizontalAlignment="Right"
                                       Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc overview_skport_profile}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="{Binding Data.Extras.Profile.Nickname}" HorizontalAlignment="Right"
                                       Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="{loc:Loc overview_source}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="skport" HorizontalAlignment="Right" Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                        <TextBlock Text="{loc:Loc overview_next_step}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{loc:Loc overview_next_step_text}"
                                   Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Resources -->
            <TextBlock Text="{loc:Loc overview_resources}" Style="{StaticResource Text.Kicker}" Margin="0,24,0,8"/>
            <WrapPanel>
                <Border Style="{StaticResource CardBorder}" Padding="14" Width="180" Margin="0,0,8,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc resource_sanity}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Data.Snapshot.StaminaText}" Style="{StaticResource Text.Value}"
                                   FontSize="24" Margin="0,2,0,0"/>
                        <TextBlock Text="{loc:Loc resource_sanity_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                        <ProgressBar Style="{StaticResource AefProgress}" Value="{Binding Data.Snapshot.StaminaPercent, Mode=OneWay}" Foreground="{Binding Data.Snapshot.StaminaPercent, Converter={StaticResource ProgressBrush}}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14" Width="180" Margin="0,0,8,10">
                    <StackPanel>
                        <TextBlock Text="BATTLE PASS" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Data.Snapshot.BpText}" Style="{StaticResource Text.Value}"
                                   FontSize="24" Margin="0,2,0,0"/>
                        <TextBlock Text="{loc:Loc resource_bp_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                        <ProgressBar Style="{StaticResource AefProgress}" Value="{Binding Data.Snapshot.BpPercent, Mode=OneWay}" Foreground="{Binding Data.Snapshot.BpPercent, Converter={StaticResource ProgressBrush}}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14" Width="180" Margin="0,0,8,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc resource_daily}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Data.Snapshot.DailyText}" Style="{StaticResource Text.Value}"
                                   FontSize="24" Margin="0,2,0,0"/>
                        <TextBlock Text="{loc:Loc resource_daily_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                        <ProgressBar Style="{StaticResource AefProgress}" Value="{Binding Data.Snapshot.DailyPercent, Mode=OneWay}" Foreground="{Binding Data.Snapshot.DailyPercent, Converter={StaticResource ProgressBrush}}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14" Width="180" Margin="0,0,8,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc resource_weekly}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Data.Snapshot.WeeklyText}" Style="{StaticResource Text.Value}"
                                   FontSize="24" Margin="0,2,0,0"/>
                        <TextBlock Text="{loc:Loc resource_weekly_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                        <ProgressBar Style="{StaticResource AefProgress}" Value="{Binding Data.Snapshot.WeeklyPercent, Mode=OneWay}" Foreground="{Binding Data.Snapshot.WeeklyPercent, Converter={StaticResource ProgressBrush}}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14" Width="180" Margin="0,0,8,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc resource_credits}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Data.Snapshot.CreditText}" Style="{StaticResource Text.Value}"
                                   FontSize="24" Margin="0,2,0,0"/>
                        <TextBlock Text="Skport" Style="{StaticResource Text.Meta}" FontSize="11"/>
                        <ProgressBar Style="{StaticResource AefProgress}" Value="{Binding Data.Snapshot.CreditPercent, Mode=OneWay}" Foreground="{Binding Data.Snapshot.CreditPercent, Converter={StaticResource ProgressBrush}}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14" Width="180" Margin="0,0,8,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc resource_seek}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Data.Snapshot.SeekText}" Style="{StaticResource Text.Value}"
                                   FontSize="18" Margin="0,7,0,0"/>
                        <TextBlock Text="{loc:Loc resource_seek_hint}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                        <ProgressBar Style="{StaticResource AefProgress}" Value="{Binding Data.Snapshot.SeekPercent, Mode=OneWay}" Foreground="{Binding Data.Snapshot.SeekPercent, Converter={StaticResource ProgressBrush}}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Diff + collection -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145*"/>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{loc:Loc overview_since_last}" Style="{StaticResource Text.Kicker}"/>
                            <TextBlock Text="{Binding Data.DiffSummary}" Style="{StaticResource Text.MonoSmall}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding OverviewDiffLines}" Margin="0,14,0,0"
                                      Visibility="{Binding HasDiffChanges, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Fill="{Binding Kind, Converter={StaticResource DiffKindBrush}}"
                                                   VerticalAlignment="Stretch"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Text.Body}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding DiffEmptyText}" Style="{StaticResource Text.Meta}"
                                   Margin="0,14,0,0"
                                   Visibility="{Binding HasDiffChanges, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasDiffChanges, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{loc:Loc overview_next_snapshot_shows}" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc overview_next_01}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBlock Text="{loc:Loc overview_next_02}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBlock Text="{loc:Loc overview_next_03}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>
                        <Grid>
                            <TextBlock Text="{loc:Loc overview_compare_hint}"
                                       Style="{StaticResource Text.Meta}" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Meta.SnapshotsCount}" Style="{StaticResource Text.Mono}"
                                           Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc overview_snapshots_suffix}" Style="{StaticResource Text.Kicker}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{loc:Loc overview_collection}" Style="{StaticResource Text.Kicker}"/>
                            <TextBlock Text="{Binding Data.Snapshot.Id, StringFormat=# {0}}" Style="{StaticResource Text.MonoSmall}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,14,0,12">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc overview_operators}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.CharNum}" Style="{StaticResource SmallValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc overview_weapons}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.WeaponNum}" Style="{StaticResource SmallValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc overview_documents}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.DocNum}" Style="{StaticResource SmallValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc overview_achievements}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Data.Snapshot.AchieveCount}" Style="{StaticResource SmallValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc overview_gear_inventory}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="{Binding InventoryText}" HorizontalAlignment="Right" Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc overview_tactical_items}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="{Binding Data.Extras.Inventory.TacticalItems}" HorizontalAlignment="Right" Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc overview_locations}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="{Binding LocationsCount}" HorizontalAlignment="Right" Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="{loc:Loc overview_plates}" Style="{StaticResource Text.Meta}"/>
                            <TextBlock Text="{Binding PlatedCount}" HorizontalAlignment="Right" Style="{StaticResource Text.MonoSmall}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top operators -->
            <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc overview_core}" Style="{StaticResource Text.Kicker}"/>
                        <TextBlock Text="{loc:Loc overview_core_hint}" Style="{StaticResource Text.Kicker}"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Faint}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TopOperators}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:OperatorCard Margin="0,0,12,12"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>




