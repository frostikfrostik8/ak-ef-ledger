<UserControl x:Class="AefAccount.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ВСЕГО" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding Data.Achievements.Count}" Style="{StaticResource Text.Value}" FontSize="24" Margin="0,2,0,0"/>
                    <TextBlock Text="открыто" Style="{StaticResource Text.Meta}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ПЛАШКИ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding PlatedCount}" Style="{StaticResource Text.Value}" FontSize="24" Margin="0,2,0,0"/>
                    <TextBlock Text="отмечено" Style="{StaticResource Text.Meta}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="КАТЕГОРИЙ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding AchievementCategoryCount}" Style="{StaticResource Text.Value}" FontSize="24" Margin="0,2,0,0"/>
                    <TextBlock Text="разных" Style="{StaticResource Text.Meta}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="ПОСЛЕДНЕЕ" Style="{StaticResource Text.Kicker}" FontSize="9"/>
                    <TextBlock Text="{Binding Data.Achievements[0].Name}" Style="{StaticResource Text.Body}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Data.Achievements[0].ObtainedText}" Style="{StaticResource Text.MonoSmall}"
                               FontSize="9" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Bg.Panel}"
                BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="1"
                Padding="12,6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBox Style="{StaticResource SearchTextBox}" Width="280" Tag="Поиск достижения…"
                             Text="{Binding AchievementSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <ComboBox Width="190" ItemsSource="{Binding AchievementCategories}"
                              SelectedItem="{Binding SelectedAchievementCategory}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding AchievementCountText}" Style="{StaticResource Text.Mono}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredAchievements}" Margin="0,0,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="12" Width="380" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34"
                                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                            Background="{DynamicResource Brush.Bg.Sunken}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                            <TextBlock Text=" · " Style="{StaticResource Text.Meta}" FontSize="11"/>
                                            <TextBlock Text="{Binding LevelText}" Style="{StaticResource Text.Meta}" FontSize="11"/>
                                            <TextBlock Text=" · " Style="{StaticResource Text.Meta}" FontSize="11"/>
                                            <TextBlock Text="{Binding ObtainedText}" Style="{StaticResource Text.MonoSmall}" FontSize="9"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource ChipBorder}" HorizontalAlignment="Left"
                                                Margin="0,6,0,0" Padding="7,2"
                                                BorderBrush="{DynamicResource Brush.Rarity.6}"
                                                Visibility="{Binding IsPlated, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="ПЛАШКА" FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="8" Foreground="{DynamicResource Brush.Rarity.6}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="{DynamicResource Brush.Bg.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    MaxWidth="380" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasAchievementResults, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="// ПУСТО" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource Brush.Warn}"/>
                    <TextBlock Text="Достижения не найдены" Style="{StaticResource Text.H2}" Margin="0,8,0,4"/>
                    <TextBlock Text="Измени категорию или поисковый запрос." Style="{StaticResource Text.Meta}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>



