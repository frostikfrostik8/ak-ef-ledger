<UserControl x:Class="AefAccount.Controls.OperatorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AefAccount.Controls"
             x:Name="Self">
    <Button x:Name="Root" Click="Root_Click" Cursor="Hand" Background="Transparent"
            HorizontalContentAlignment="Stretch" BorderThickness="0" Width="168">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Card"
                        Background="{DynamicResource Brush.Bg.Raised}"
                        BorderBrush="{DynamicResource Brush.Line.Soft}"
                        BorderThickness="1"
                        Padding="0"
                        SnapsToDevicePixels="True">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Line.Strong}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Bg.Selected}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="215"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Media -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Border Background="{Binding ElementTintHex, Converter={StaticResource HexBrush}}"/>
                <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Display}"
                           FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Faint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Name, Converter={StaticResource OperatorArtVisibility}, ConverterParameter=portrait}"/>
                <Image Source="{Binding Name, Converter={StaticResource OperatorArt}, ConverterParameter=portrait}"
                       Stretch="UniformToFill" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,166,215"/>
                    </Image.Clip>
                </Image>

                <Border Width="24" Height="24" Background="#B3000000"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                    <TextBlock Text="{Binding ClassCode}" FontFamily="{StaticResource Font.Mono}"
                               FontSize="7" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Width="24" Height="24" Background="{Binding ElementHex, Converter={StaticResource HexBrush}}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                    <TextBlock Text="{Binding ElementCode}" FontFamily="{StaticResource Font.Mono}"
                               FontSize="6.5" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Rectangle Height="3" VerticalAlignment="Bottom"
                           Fill="{Binding ElementHex, Converter={StaticResource HexBrush}}"/>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="1" Margin="8,3,8,3">
                <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource Font.Ui}" FontSize="12.5"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                           TextTrimming="CharacterEllipsis"/>
                <controls:RarityChevrons Rarity="{Binding Rarity}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
