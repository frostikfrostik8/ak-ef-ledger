<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AkEfLedger</AssemblyName>
    <Product>AK:EF Ledger</Product>
    <Title>AK:EF Ledger</Title>
    <Version>0.4.2</Version>
    <FileVersion>0.4.2.0</FileVersion>
    <AssemblyVersion>0.4.2.0</AssemblyVersion>
    <ApplicationIcon>Assets\akef.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <Resource Include="Assets\akef.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Встроенной остаётся только тестовая Веспер: остальной арт лежит рядом с exe.
         EmbeddedResource, а не WPF Resource: pack:// URI ломается в single-file publish. -->
    <EmbeddedResource Include="Assets\Operators\vesper\*.png" />
  </ItemGroup>

  <!-- Полный арт копируется в assets\operators, а не вшивается в exe.
       В чистом клоне без реальных артов остаётся только vesper. -->
  <ItemGroup>
    <Content Include="Assets\Operators\**\*.png">
      <Link>assets\operators\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Языковые файлы: внешние lang/*.json рядом с exe + встроенный резерв. -->
  <ItemGroup>
    <None Remove="Localization\Lang\ru.json" />
    <None Remove="Localization\Lang\en.json" />
    <Content Include="Localization\Lang\ru.json" Link="lang\ru.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Localization\Lang\en.json" Link="lang\en.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Localization\Lang\ru.json" />
    <EmbeddedResource Include="Localization\Lang\en.json" />
    <None Update="Localization\Lang\README.md" Link="lang\README.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
